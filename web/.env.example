# Public park prototype. Both sites must point at the SAME Supabase project.
NEXT_PUBLIC_WN_SUPABASE_URL=
NEXT_PUBLIC_WN_SUPABASE_ANON_KEY=
# Optional canonical phone entry point, e.g. https://your-preview.vercel.app/park
NEXT_PUBLIC_WN_FENCEPOST_URL=
# Existing storyboard routes retain their existing environment variables.
NEXT_PUBLIC_FENCEPOST_MODE=fixtures
# Existing storyboard services use this API base URL.
# Only a non-secret API base URL belongs in this frontend file.
NEXT_PUBLIC_FENCEPOST_API=http://127.0.0.1:8787
# Model-provider keys and FENCEPOST_TOKEN_SECRET stay in the Python API project's
# server environment, never in NEXT_PUBLIC_* variables or shared browser config.
# Booth storyboard on the display (WILDLIFE-PREVIEW.md). scripts/issue_booth_screen.py writes
# all four into web/.env.production.local; the token is server-side only, never NEXT_PUBLIC_.
NEXT_PUBLIC_WN_BOOTH_JOIN_URL=
FENCEPOST_API=
FENCEPOST_BOOTH_STORYBOARD=
FENCEPOST_BOOTH_TOKEN=
